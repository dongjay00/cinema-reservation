{
  "name": "cinema-reservation",
  "private": true,
  "scripts": {
    "dev:api": "npm run dev --workspace @cinema/api",
    "dev:web": "npm run dev --workspace @cinema/web",
    "test:api": "npm run test --workspace @cinema/api",
    "test:web": "npm run test --workspace @cinema/web",
    "test": "npm run test:api && npm run test:web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
